# 六、完整代码

```python
class WordTokenizer:

    def __init__(self,text):

        self.build(text)

    def build(self,text):

        words=text.split()

        vocab=sorted(set(words))

        self.stoi={

            w:i

            for i,w in enumerate(vocab)

        }

        self.itos={

            i:w

            for w,i in self.stoi.items()

        }

    def encode(self,text):

        return [

            self.stoi[w]

            for w in text.split()

        ]

    def decode(self,ids):

        return " ".join(

            self.itos[i]

            for i in ids

        )
```

总代码：

不到：

30 行。

